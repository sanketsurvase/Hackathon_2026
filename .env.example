# ── Option A: Full connection string (Render provides this) ──
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Option B: Individual variables (local development) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kisansetu_db
DB_USER=postgres
DB_PASSWORD=farmer
